{
  "layer": "top",
  "position": "bottom",
  "margin-left": 0,
  "margin-top": 0,
  "margin-right": 0,
  "margin-bottom": 0,

  "modules-left": [
    // "niri/workspaces",
    "ext/workspaces",
    "mpris",
  ],
  // "modules-center": ["mpris"],
  "modules-right": [
    "tray",
    // "custom/uptime",
    "cpu",
    "custom/memory",
    "custom/disk",
    "network",
    "pulseaudio",
    "battery",
    "clock",
  ],
  // "modules-left": [
  //   "custom/arch",
  //   // "hyprland/workspaces",
  //   // "niri/workspaces",
  //   // "hyprland/window",
  //   // "niri/window",
  //   // "tray",
  //   "mpris",
  // ],
  // "modules-center": ["clock"],
  // "modules-right": [
  //   "network",
  //   "cpu",
  //   "custom/cpu_temp",
  //   "backlight",
  //   "custom/memory",
  //   "pulseaudio",
  //   // "custom/sensors",
  //   "battery"
  // ],

  "hyprland/workspaces": {
    "format": "{icon}",
    "format-icons": {
      // "1": "I",
      // "2": "II",
      // "3": "III",
      // "4": "IV",
      // "5": "V",
      // "6": "VI",
      // "7": "VII",
      // "8": "VIII",
      // "9": "IX",
      // "10": "X",
    },
    "on-scroll-up": "hyprctl dispatch workspace e+1",
    "on-scroll-down": "hyprctl dispatch workspace e-1",
  },
  "hyprland/window": {
    "format": "{class}",
    "max-length": 30,
    "format-alt": "",
    "separate-outputs": true,
    "icon": true,
    "icon-size": 20,
    "tooltip": false,
  },
  "tray": {
    "spacing": 10,
  },
  "mpris": {
    "format": "{player_icon} {dynamic}",
    "format-paused": "{status_icon} <i>{dynamic}</i>",
    "max-length": 40,
    // "format": "{player_icon}</span> {dynamic}",
    // "format-paused": "{status_icon} <i>{dynamic}</i>",
    "interval": 1,
    "player-icons": {
      "default": "▶",
      "mpv": "",
    },
    "status-icons": {
      "paused": "⏸",
    },
    "on-click": "playerctl play-pause",
    "on-click-right": "playerctl next",
    "on-click-middle": "playerctl previous",
    // "max-length": 30,
    "width": 0,
  },

  "clock": {
    "format": "<span color='#98BB6C'> </span> {:%a %d | %H:%M:%S}",
    "tooltip-format": "<tt><small>{calendar}</small></tt>",
    "calendar": {
      "mode": "year",
      "mode-mon-col": 3,
      "weeks-pos": "right",
      "on-scroll": 1,
      "format": {
        "months": "<span color='#DCD7BA'><b>{}</b></span>",
        "days": "<span color='#f2ecbc'><b>{}</b></span>",
        "weeks": "<span color='#8a9aa3'><b>W{}</b></span>",
        "weekdays": "<span color='#DCA561'><b>{}</b></span>",
        "today": "<span color='#E46876'><b><u>{}</u></b></span>",
      },
    },
    "on-click": "gnome-calendar",
    "interval": 1,
  },

  "network": {
    "interval": 2,
    "format": " {bandwidthDownBits}  {bandwidthUpBits}",
    "format-wifi": " {bandwidthDownBits}  {bandwidthUpBits}",
    "format-ethernet": " {bandwidthDownBits}  {bandwidthUpBits}",
    "tooltip": false,
    "states": {
      "normal": 25,
    },
  },
  "cpu": {
    "format": "<span color='#FF5D62'> </span>{usage}%",
    "tooltip": false,
    "interval": 1,
  },
  "custom/cpu_temp": {
    "exec": "~/.config/waybar/scripts/cpu_temp.sh",
    "return-type": "json",
    "interval": 2,
    "format": "{}",
    "tooltip": false,
  },
  "backlight": {
    "scroll-step": 1,
    "format": "<span color='#E6C384'>󰃠 </span>{percent}%",
    "tooltip": false,
  },
  "custom/memory": {
    "exec": "~/.config/waybar/scripts/memory_usage.sh",
    "interval": 2,
    "return-type": "json",
    "format": "<span color='#C0A36E'> </span> {}",
  },
  "pulseaudio": {
    // "scroll-step": 1, // %, can be a float
    "format": "<span color='#98BB6C'>  {volume}%</span>",
    "format-muted": "<span color='#98BB6C'>  {volume}%</span>",
    "format-bluetooth": "<span color='#98BB6C'>󰂰 {volume}%</span>",
    "format-bluetooth-muted": "<span color='#98BB6C'>󰂲 {volume}%</span>",
    "format-source": "{volume}% ",
    "on-click": "pactl set-sink-mute @DEFAULT_SINK@ toggle",
    "on-click-right": "pavucontrol",
    "tooltip": "{volume}%",
    "max-volume": 150,
  },
  // "custom/sensors": {
  //   "exec": "~/.config/waybar/scripts/sensors.sh",
  //   "interval": 5,
  //   "format": "<span color='#7AA89F'></span>",
  //   "tooltip": true,
  //   "tooltip-format": "{output}",
  // },
  "battery": {
    "interval": 1,
    "states": {
      "good": 99,
      "warning": 30,
      "critical": 20,
    },
    "format-icons": ["󰂎", "󰁺", "󰁻", "󰁽", "󰁾", "󰁿", "󰂀", "󰂁", "󰂂", "󰁹"],
    "format": "<span color='#76946A'>{icon} </span>{capacity}%",
    "format-critical": "<span color='#C34043'>{icon} </span>{capacity}%!!",
    "format-warning": "<span color='#FFA066'>{icon} </span>{capacity}%",
    "format-full": "<span color='#76946A'>{icon} </span>{capacity}%",
    "format-charging": "<span color='#76946A'>󰂅 </span>{capacity}%",
    "format-charging-warning": "<span color='#FFA066'>󰢝 </span>{capacity}%",
    "format-charging-critical": "<span color='#C34043'>󰢜 </span>{capacity}%",
    "format-plugged": "<span color='#76946A'>󰂅 </span>{capacity}%",
    "format-alt": "<span color='#76946A'>󱧥 </span>{time}",
    "tooltip": false,
  },

  "custom/network": {
    "exec": "~/.config/waybar/scripts/network.sh",
    "interval": 1,
    "return-type": "json",
    "format": "<span color='#7AA89F'> {down} {up}</span>",
    "tooltip": false,
  },
  "custom/uptime": {
    "exec": "uptime -p | sed 's/up //'",
    "interval": 60,
    "format": "<span color='#B5CEA8'> {}</span>",
  },
  "custom/disk": {
    "exec": "df -h / | awk 'NR==2{print $4\" Free\"}'",
    "interval": 120,
    "format": "<span color='#E6C384'> {}</span>",
  },
}

selection-background = #22262D
selection-foreground = #c5c9c7

font-family = Lilex Nerd Font

shell-integration = zsh

window-decoration = false
gtk-titlebar = false
window-vsync = true

# Keybinds
keybind = super+shift+right_bracket=goto_split:next
keybind = super+shift+left_bracket=goto_split:previous
keybind = super+shift+enter=toggle_split_zoom
keybind = super+ctrl+shift+k=resize_split:up,10
keybind = super+ctrl+shift+h=resize_split:left,10
keybind = super+ctrl+shift+j=resize_split:down,10
keybind = super+ctrl+shift+l=resize_split:right,10

# theme = Apple System Colors Light 


custom-shader = shaders/cursor_tail.glsl
